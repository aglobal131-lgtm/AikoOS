<UserControl x:Class="AikoOS.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="32">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <TextBlock Text="Home"
                                           FontSize="32"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding WelcomeMessage,
                                          Mode=OneWay}"
                                           FontSize="17"
                                           Margin="0,16,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding ClickCount,
                                          Mode=OneWay}"
                                           FontSize="24"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"/>

                                <Button Content="Increase count"
                                        Command="{Binding IncreaseCountCommand}"
                                        Width="160"
                                        Height="38"
                                        Margin="0,16,0,0"/>

                                <Border Width="460"
                                        Padding="20"
                                        Margin="0,28,0,0"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                        <StackPanel>
                                                <TextBlock Text="{Binding RuntimeStatusText,
                                                 StringFormat=Runtime status: {0},
                                                 Mode=OneWay}"/>

                                                <TextBlock Text="{Binding StartedAtText,
                                                 StringFormat=Started at: {0},
                                                 Mode=OneWay}"
                                                           Margin="0,10,0,0"/>

                                                <TextBlock Text="{Binding UptimeText,
                                                 StringFormat=Uptime: {0},
                                                 Mode=OneWay}"
                                                           Margin="0,10,0,0"/>
                                        </StackPanel>
                                </Border>

                        </StackPanel>
                </Grid>
        </ScrollViewer>
</UserControl>