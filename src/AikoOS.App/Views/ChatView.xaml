<UserControl x:Class="AikoOS.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="900">

    <Grid Background="#101218">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="20,16"
                Background="#171A22"
                BorderBrush="#292E3A"
                BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Aiko Chat"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#A9B0C3"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Width="110"
                        Height="36"
                        Content="Làm mới"
                        Command="{Binding ClearConversationCommand}"/>

            </Grid>
        </Border>

        <!-- Messages -->
        <ListBox x:Name="MessagesListBox"
                 Grid.Row="1"
                 Margin="16"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">

                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>

                    <Setter Property="Padding"
                            Value="0"/>

                    <Setter Property="Margin"
                            Value="0,5"/>

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="BorderThickness"
                            Value="0"/>

                    <Setter Property="Focusable"
                            Value="False"/>

                    <Setter Property="IsHitTestVisible"
                            Value="False"/>

                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Grid>
                        <Border MaxWidth="650"
                                Padding="14"
                                CornerRadius="12"
                                HorizontalAlignment="{Binding IsUser,
                                    Converter={StaticResource MessageAlignmentConverter}}"
                                Background="{Binding IsUser,
                                    Converter={StaticResource MessageBackgroundConverter}}">

                            <StackPanel>

                                <TextBlock Text="{Binding DisplayName}"
                                           Margin="0,0,0,6"
                                           FontWeight="SemiBold"
                                           Foreground="#9FC2FF"/>

                                <TextBlock Text="{Binding Content}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           LineHeight="21"
                                           Foreground="#F2F4F8"/>

                            </StackPanel>
                        </Border>
                    </Grid>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Input -->
        <Border Grid.Row="2"
                Margin="16,0,16,8"
                Padding="12"
                CornerRadius="12"
                Background="#171A22"
                BorderBrush="#303645"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInputTextBox"
                         Grid.Column="0"
                         MinHeight="44"
                         MaxHeight="130"
                         Padding="10"
                         Text="{Binding InputMessage,
                                        UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         CaretBrush="White"
                         FontSize="14"
                         PreviewKeyDown="MessageInputTextBox_OnPreviewKeyDown"/>

                <Button Grid.Column="1"
                        Width="92"
                        Height="44"
                        Margin="10,0,0,0"
                        VerticalAlignment="Bottom"
                        Content="Gửi"
                        Command="{Binding SendMessageCommand}"/>

            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3"
              Margin="16,0,16,14">

            <TextBlock Text="Enter để gửi • Shift + Enter để xuống dòng"
                       VerticalAlignment="Center"
                       Foreground="#737B91"
                       FontSize="12"/>

            <Button Width="100"
                    Height="32"
                    HorizontalAlignment="Right"
                    Content="Hủy"
                    Visibility="{Binding IsSending,
                        Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{Binding CancelRequestCommand}"/>

        </Grid>

    </Grid>
</UserControl>